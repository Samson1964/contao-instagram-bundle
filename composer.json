{
    "name": "schachbulle/contao-instagram-bundle",
    "type": "contao-bundle",
    "description": "Inhaltselement, das einen einzelnen Instagram-Beitrag (Foto, Reel oder Video) über die offizielle Einbettung anzeigt. Es genügt der Link zum Beitrag; weder Facebook-App noch Zugriffsschlüssel sind nötig.",
    "keywords": [
        "contao",
        "inhaltselement",
        "instagram",
        "reel",
        "beitrag",
        "einbetten",
        "embed",
        "social media"
    ],
    "homepage": "https://github.com/Samson1964/contao-instagram-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "contao/core-bundle": "^4.13 || ^5.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoInstagramBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoInstagramBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schachbulle\\ContaoInstagramBundle\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-instagram-bundle/issues",
        "source": "https://github.com/Samson1964/contao-instagram-bundle"
    }
}
