
<div class="<?= $this->class ?> block"<?= $this->cssID ?><?php if ($this->style): ?> style="<?= $this->style ?>"<?php endif; ?>>

  <?php if ($this->headline): ?>
    <<?= $this->hl ?>><?= $this->headline ?></<?= $this->hl ?>>
  <?php endif; ?>

  <blockquote class="instagram-media" data-instgrm-permalink="<?= $this->permalink ?>" data-instgrm-version="<?= $this->embedVersion ?>"<?php if ($this->captioned): ?> data-instgrm-captioned<?php endif; ?>>
    <a href="<?= $this->permalink ?>" target="_blank" rel="noopener"><?= $this->linkText ?></a>
  </blockquote>

</div>
